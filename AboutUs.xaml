<Window x:Class="LAZ_to_LAS_File_Converter.AboutUs"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Us - LAZ to LAS File Converter" Height="425" Width="450"
        WindowStartupLocation="CenterScreen"
        Background="#FFE0E0E0">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- AgriMetSoft Section -->
        <GroupBox Header="AgriMetSoft" Grid.Column="0" Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <TextBlock Grid.Row="0" HorizontalAlignment="Center" Margin="10">
                    <Hyperlink Name="lnkImg" TextDecorations="None" NavigateUri="http://agrimetsoft.com">
                        <Image Source="/img/Icon_AgriMetSoft1.png" Width="100" Height="100"/>
                    </Hyperlink>
                </TextBlock>

                <!-- Mission Statement -->
                <TextBlock Grid.Row="1" TextAlignment="Justify" VerticalAlignment="Top" TextWrapping="Wrap" Margin="10">
                    AgriMetSoft's mission is to create user-friendly software applications that assist scholars, researchers, and scientists in investigating, evaluating, and analyzing data.
                </TextBlock>

                <!-- Social Media Buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                    <Button Width="60" Background="Transparent" BorderBrush="Transparent" Height="60" Margin="5" Click="Button_Click_1">
                        <Image Source="img/facebook.png"/>
                    </Button>
                    <Button Width="60" Background="Transparent" BorderBrush="Transparent" Height="60" Margin="5" Click="Button_Click_2">
                        <Image Source="img/twtter.png"/>
                    </Button>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- LAZ to LAS File Converter Section -->
        <GroupBox Grid.Column="1" Margin="10" Header="LAZ to LAS File Converter">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Tool Description -->
                <TextBlock Grid.Row="0" TextAlignment="Justify" TextWrapping="Wrap" Margin="10">
                    The LAZ to LAS File Converter is a powerful and user-friendly tool designed to convert compressed LAZ files into the standard LAS format. It supports batch processing, ensuring efficient handling of multiple files, and provides detailed error reporting for seamless troubleshooting.
                </TextBlock>

                <!-- Copyright -->
                <TextBlock Grid.Row="1" Text="Copyright © AgriMetSoft 2025" VerticalAlignment="Center" Margin="10,5"/>

                <!-- Version -->
                <TextBlock Grid.Row="2" Text="Version 1.0" VerticalAlignment="Center" Margin="10,5"/>

                <!-- Buttons -->
                <StackPanel Grid.Row="3"  HorizontalAlignment="Center" Margin="10">
                    <Button Content="Back" Width="70" Height="30" Margin="5" Click="Button_Click"/>
                    <Button Content="Visit Our Website" Width="120" Height="30" Margin="5" Click="Button_Click_3"/>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</Window>