<Window x:Class="LAZ_to_LAS_File_Converter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LAZ_to_LAS_File_Converter"
        mc:Ignorable="d" SizeChanged="Window_SizeChanged"
        Title="LAZ to LAS Converter" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#FFE0E0E0">
    <Window.Resources>
        <!-- Style for centering DataGrid column headers -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
        <!-- Define a modern button style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF0078D7" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="2" Color="#40000000" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF005A9E" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#FFCCCCCC" />
                    <Setter Property="Foreground" Value="#FF666666" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Define a modern progress bar style -->
        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="#FF0078D7" />
            <Setter Property="Background" Value="#FFCCCCCC" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="25" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <Grid x:Name="PART_Track">
                                <Rectangle x:Name="PART_Indicator"
                                           Fill="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Left"
                                         RadiusX="5" RadiusY="5" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ToolBar Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Left" Name="toolB" Width="Auto">
            <ToolBar.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.5">
                    <GradientStop Color="Orange" Offset="0" />
                    <GradientStop Color="#FFD1C0B0"	Offset="1" />
                </LinearGradientBrush>
            </ToolBar.Background>
            <Button	Name="quit" ToolTip="Exit From App" Click="quit_Click">
                <Image Source="img/quit.png"/>
            </Button>
            <Button	Name="restart" ToolTip="Restart App" Click="restart_Click">
                <Image Source="img/reset.png"/>
            </Button>
            <Button Name="aboutus" ToolTip="About Us" Click="aboutus_Click">
                <Image Source="img/aboutus.jpg"/>
            </Button>
            <Button ToolTip="Visit Website" Click="Button_Click">
                <Hyperlink TextDecorations="None" NavigateUri="https://agrimetsoft.com">
                    <Image Source="/img/link.png"/>
                </Hyperlink>
            </Button>
            <Button x:Name="linkProducts" ToolTip="Check Products on Website" Click="linkProducts_Click">
                <Hyperlink TextDecorations="None" NavigateUri="https://agrimetsoft.com/products">
                    <Image Source="/img/products.jpg" />
                </Hyperlink>
            </Button>
            <Separator/>
        </ToolBar>
        <!-- Top Panel with Buttons and Progress Bar -->
        <StackPanel Grid.Row="1" Margin="20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                <Button x:Name="selectLAZ" Content="Select LAZ Files" Width="140" Margin="10,0" Click="selectLAZ_Click" />
                <Button x:Name="browseFolder" Content="Select LAS Folder" Width="140" Margin="10,0" IsEnabled="False" Click="browseFolder_Click" />
                <Button x:Name="Convert" Content="Convert LAZ Files" Width="140" Margin="10,0" IsEnabled="False" Click="Convert_Click" />
            </StackPanel>

            <!-- Progress Bar with Percentage -->
            <Grid Margin="0,20">
                <ProgressBar x:Name="progress" Value="{Binding ProgressValue}" />
                <TextBlock Text="{Binding ProgressValue, StringFormat={}{0:F2}%}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="Black"
                           FontSize="14"
                           FontWeight="Bold" />
            </Grid>
        </StackPanel>

        <!-- Report Section -->
        <GroupBox Grid.Row="2" Header="Report" Margin="20,10" FontSize="14" FontWeight="Bold">
            <DataGrid x:Name="dg" AutoGenerateColumns="False" ItemsSource="{Binding}" CanUserAddRows="False"
                      ColumnHeaderStyle="{StaticResource {x:Type DataGridColumnHeader}}">
                <DataGrid.Columns>
                    <!-- File Name Column -->
                    <DataGridTextColumn Header="File Name" Width="*" MinWidth="230" Binding="{Binding FileName}" />
                    <DataGridTextColumn Header="Number of Point" Width="*" MinWidth="150" Binding="{Binding NumPoint}" />
                    <DataGridTextColumn Header="MinMax/XY" Width="*" MinWidth="250" Binding="{Binding Domain}" />

                    <!-- Done Column with Custom Template -->
                    <DataGridTemplateColumn Header="Done" MinWidth="60" Width="*" >
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="✔" />
                                            <Setter Property="Foreground" Value="Green" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Done}" Value="False">
                                                    <Setter Property="Text" Value="❌" />
                                                    <Setter Property="Foreground" Value="Red" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Error Column -->
                    <DataGridTemplateColumn Header="Error" MinWidth="200" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- Tick mark for true, red cross mark for false -->
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Error}" />
                                            <Setter Property="Foreground" Value="Green" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Done}" Value="False">
                                                    <Setter Property="Text" Value="{Binding Error}" />
                                                    <Setter Property="Foreground" Value="Red" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</Window>